{
	"bsonType": "object",
	"required": ["article_id",  "user_content"],
	"permission": {
		"read": true,
		// "create": "auth.uid != null && get(`database.opendb-news-articles.${doc.article_id}`).comment_status == 1",
		"create":"auth.uid != null",
		"update": "doc.user_id == auth.uid",
		"delete": "doc.user_id == auth.uid"
	},
	"properties": {
		"_id": {
			"description": "存储文档 ID（文章 ID），系统自动生成"
		},
		"article_id": {
			"title": "评论的文章",
			"bsonType": "string",
			"description": "文章ID，opendb-news-posts 表中的`_id`字段",
			"foreignKey": "opendb-news-articles._id",
			"enum":{
				"collection": "opendb-news-articles",
				"field": "title as text,_id as value"
			}
		},
		"user_id": {
			"title": "评论人",
			"bsonType": "string",
			"description": "评论者ID，参考`uni-id-users` 表",
			"foreignKey": "uni-id-users._id",
			"enum":{
				"collection": "uni-id-users",
				"field": "username as text,_id as value"
			},
			"forceDefaultValue": {
				"$env": "uid"
			}
		},
		"user_content": {
			"title":"评论内容",
			"bsonType": "string",
			"description": "评论内容",
			"title": "评论内容",
			"trim": "right"
		},
	
		"reply_id": {
			"bsonType": "string",
			"title": "被回复的评论id",
			"description": "被回复的评论id，二级回复",
			"foreignKey": "opendb-news-comments._id",
			"enum":{
				"collection": "opendb-news-comments",
				"field": "comment_content as text,_id as value"
			}
		},
      "reply_name": {
			"bsonType": "string",
			"title": "被回复人名称",
			"description": "被回复人名称"
		},
		"parent_id": {
			"bsonType": "string",
			"title": "首级评论id",
			"description": "被回复的评论ID，comment_type为1时有效",
			"foreignKey": "opendb-news-comments._id",
			"enum":{
				"collection": "opendb-news-comments",
				"field": "comment_content as text,_id as value"
			}
		},
		"status":{
			"bsonType": "bool",
			"title": "状态值",
			"defaultValue":true
		},
		"create_time": {
			"bsonType": "timestamp",
			"description": "评论发表时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"create_ip": {
			"bsonType": "string",
			"description": "评论发表时 IP 地址",
			"forceDefaultValue": {
				"$env": "clientIP"
			}
		},
		"city":{
			"bsonType": "string",
			"title": "评论者所在城市",
			"description": "和comment_ip联动,通过高德地图api查询所得"
		}
	}
}
