{
	"bsonType": "object",
	"required": ["user_id", "article_id"],
	"permission": {
		"read": true,
		"create": "auth.uid != null",
		"update": "doc.user_id == auth.uid",
		"delete": "doc.user_id == auth.uid"
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"article_id": {
			"title": "收藏的文章",
			"bsonType": "string",
			"description": "文章id，参考opendb-news-articles表",
			"foreignKey": "opendb-news-articles._id",
			"enum": {
				"collection": "opendb-news-articles",
				"field": "title as text, _id as value"
			}
		},
		"user_id": {
			"title": "用户",
			"bsonType": "string",
			"description": "收藏者id，参考uni-id-users表",
			"forceDefaultValue": {
				"$env": "uid"
			},
			"foreignKey": "uni-id-users._id",
			"enum": {
				"collection": "uni-id-users",
				"field": "username as text,_id as value"
			}
		},
		"create_date": {
			"bsonType": "timestamp",
			"description": "收藏时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	}
}